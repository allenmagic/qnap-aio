# Hardware Configuration Placeholder
#
# This file will be generated automatically during NixOS installation.
# Run: nixos-generate-config --root /mnt
# Then move the generated hardware-configuration.nix to this location.
# After moving, make it visible to the flake without committing it:
#   git add -N -f hardware-configuration.nix
#
# DO NOT commit the actual hardware-configuration.nix to Git.
# It contains system-specific hardware details.

{ config, lib, pkgs, modulesPath, ... }:

{
  imports = [ ];

  # This is a placeholder. Replace with actual hardware configuration.
  boot.initrd.availableKernelModules = [ ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  nixpkgs.hostPlatform = "x86_64-linux";
}
